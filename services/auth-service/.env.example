AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace-with-local-password
AUTH_JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
AUTH_ACCESS_TOKEN_EXPIRATION=PT15M
AUTH_REFRESH_TOKEN_EXPIRATION=P30D
AUTH_JWT_ISSUER=commerce-auth-service
AUTH_SERVER_PORT=8081
